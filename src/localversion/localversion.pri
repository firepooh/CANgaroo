# Local build version (weact-local fork), read from git when qmake runs.
#
#   base  = upstream VERSION from src.pro plus the commit this branch forked from
#           (merge-base with upstream/master; empty without an "upstream" remote)
#   local = number of commits since that base, HEAD hash, commit date, "-dirty"
#           when tracked files have uncommitted changes
#
# The values go to a generated header that is rewritten only when they change,
# so an unchanged checkout does not recompile anything.

LOCAL_GIT_ROOT = $$clean_path($$PWD/../..)
win32: LOCAL_NULL = 2>nul
else:  LOCAL_NULL = 2>/dev/null
LOCAL_GIT = git -C \"$$LOCAL_GIT_ROOT\"

LOCAL_HASH = $$system($$LOCAL_GIT rev-parse --short=7 HEAD $$LOCAL_NULL)
LOCAL_DATE = $$system($$LOCAL_GIT log -1 --format=%cd --date=short $$LOCAL_NULL)
LOCAL_CHANGES = $$system($$LOCAL_GIT status --porcelain --untracked-files=no $$LOCAL_NULL)
LOCAL_BASE_FULL = $$system($$LOCAL_GIT merge-base HEAD upstream/master $$LOCAL_NULL)
!isEmpty(LOCAL_BASE_FULL) {
    LOCAL_BASE = $$str_member($$LOCAL_BASE_FULL, 0, 6)
    LOCAL_COUNT = $$system($$LOCAL_GIT rev-list --count $${LOCAL_BASE_FULL}..HEAD $$LOCAL_NULL)
}
isEmpty(LOCAL_HASH): LOCAL_HASH = unknown
LOCAL_DIRTY =
!isEmpty(LOCAL_CHANGES): LOCAL_DIRTY = -dirty

LOCAL_STAMP = //stamp=$${LOCAL_HASH}$${LOCAL_DIRTY}_$${LOCAL_DATE}_$${LOCAL_COUNT}_$${LOCAL_BASE}
LOCAL_HEADER_LINES = \
    $$LOCAL_STAMP \
    "// Generated by src/localversion/localversion.pri - do not edit" \
    "$${LITERAL_HASH}pragma once" \
    "$${LITERAL_HASH}define LOCAL_VERSION_HASH \"$${LOCAL_HASH}$${LOCAL_DIRTY}\"" \
    "$${LITERAL_HASH}define LOCAL_VERSION_DATE \"$${LOCAL_DATE}\"" \
    "$${LITERAL_HASH}define LOCAL_VERSION_COUNT \"$${LOCAL_COUNT}\"" \
    "$${LITERAL_HASH}define LOCAL_BASE_COMMIT \"$${LOCAL_BASE}\""

LOCAL_GEN_DIR = $$OUT_PWD/../build/gen
LOCAL_HEADER = $$LOCAL_GEN_DIR/local_version.h
LOCAL_OLD_LINES = $$cat($$LOCAL_HEADER, lines)
LOCAL_OLD_STAMP = $$first(LOCAL_OLD_LINES)
!equals(LOCAL_OLD_STAMP, $$LOCAL_STAMP) {
    mkpath($$LOCAL_GEN_DIR)
    write_file($$LOCAL_HEADER, LOCAL_HEADER_LINES)
}

INCLUDEPATH += $$LOCAL_GEN_DIR
HEADERS += $$PWD/LocalVersion.h
SOURCES += $$PWD/LocalVersion.cpp
